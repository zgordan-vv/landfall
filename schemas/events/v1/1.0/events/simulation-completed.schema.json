{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.landfall.dev/events/v1/1.0/events/simulation-completed.schema.json",
  "title": "solana.simulation.completed event",
  "type": "object",
  "allOf": [
    { "$ref": "../envelope.schema.json" },
    {
      "properties": {
        "event_type": { "const": "solana.simulation.completed" },
        "trace_id": {
          "$ref": "../common/identifiers.schema.json#/$defs/trace_id"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "simulation_id": {
              "$ref": "../common/identifiers.schema.json#/$defs/operation_id"
            },
            "route_id": {
              "$ref": "../common/identifiers.schema.json#/$defs/route_id"
            },
            "duration_ns": {
              "$ref": "../common/values.schema.json#/$defs/unsigned_decimal"
            },
            "transport_result": {
              "$ref": "../common/values.schema.json#/$defs/token"
            },
            "rpc_result": {
              "$ref": "../common/values.schema.json#/$defs/token"
            },
            "units_consumed": {
              "$ref": "../common/values.schema.json#/$defs/unsigned_decimal"
            },
            "logs_present": { "type": "boolean" },
            "error": { "$ref": "../common/errors.schema.json" }
          },
          "required": [
            "simulation_id",
            "route_id",
            "duration_ns",
            "transport_result",
            "rpc_result"
          ],
          "additionalProperties": false
        }
      },
      "required": ["trace_id"]
    }
  ]
}
