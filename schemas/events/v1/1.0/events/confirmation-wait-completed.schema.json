{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.landfall.dev/events/v1/1.0/events/confirmation-wait-completed.schema.json",
  "title": "solana.confirmation_wait.completed event",
  "type": "object",
  "allOf": [
    { "$ref": "../envelope.schema.json" },
    {
      "properties": {
        "event_type": { "const": "solana.confirmation_wait.completed" },
        "trace_id": {
          "$ref": "../common/identifiers.schema.json#/$defs/trace_id"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "wait_id": {
              "$ref": "../common/identifiers.schema.json#/$defs/operation_id"
            },
            "duration_ns": {
              "$ref": "../common/values.schema.json#/$defs/duration_ns_decimal"
            },
            "result": {
              "$ref": "../common/enums.schema.json#/$defs/confirmation_wait_result"
            },
            "observed_commitment": {
              "$ref": "../common/enums.schema.json#/$defs/commitment"
            },
            "error": { "$ref": "../common/errors.schema.json" }
          },
          "required": ["wait_id", "duration_ns", "result"],
          "additionalProperties": false
        }
      },
      "required": ["trace_id"]
    }
  ]
}
