{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.landfall.dev/events/v1/1.0/events/submission-started.schema.json",
  "title": "solana.submission.started event",
  "type": "object",
  "allOf": [
    { "$ref": "../envelope.schema.json" },
    {
      "properties": {
        "event_type": { "const": "solana.submission.started" },
        "trace_id": {
          "$ref": "../common/identifiers.schema.json#/$defs/trace_id"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "attempt_id": {
              "$ref": "../common/identifiers.schema.json#/$defs/attempt_id"
            },
            "route_id": {
              "$ref": "../common/identifiers.schema.json#/$defs/route_id"
            },
            "attempt_sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "encoding": { "$ref": "../common/values.schema.json#/$defs/token" },
            "skip_preflight": { "type": "boolean" },
            "preflight_commitment": {
              "$ref": "../common/values.schema.json#/$defs/token"
            },
            "max_retries": {
              "$ref": "../common/values.schema.json#/$defs/unsigned_decimal"
            },
            "min_context_slot": {
              "$ref": "../common/values.schema.json#/$defs/unsigned_decimal"
            }
          },
          "required": ["attempt_id", "route_id", "attempt_sequence", "encoding", "skip_preflight"],
          "additionalProperties": false
        }
      },
      "required": ["trace_id"]
    }
  ]
}
