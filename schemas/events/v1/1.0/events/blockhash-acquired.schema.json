{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.landfall.dev/events/v1/1.0/events/blockhash-acquired.schema.json",
  "title": "solana.blockhash.acquired event",
  "type": "object",
  "allOf": [
    { "$ref": "../envelope.schema.json" },
    {
      "properties": {
        "event_type": { "const": "solana.blockhash.acquired" },
        "trace_id": {
          "$ref": "../common/identifiers.schema.json#/$defs/trace_id"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "route_id": {
              "$ref": "../common/identifiers.schema.json#/$defs/route_id"
            },
            "result": { "$ref": "../common/enums.schema.json#/$defs/blockhash_result" },
            "duration_ns": {
              "$ref": "../common/values.schema.json#/$defs/duration_ns_decimal"
            },
            "recent_blockhash": {
              "$ref": "../common/values.schema.json#/$defs/solana_blockhash"
            },
            "last_valid_block_height": {
              "$ref": "../common/values.schema.json#/$defs/block_height_decimal"
            },
            "context_slot": {
              "$ref": "../common/values.schema.json#/$defs/slot_decimal"
            },
            "error": { "$ref": "../common/errors.schema.json" }
          },
          "required": ["route_id", "result", "duration_ns"],
          "additionalProperties": false
        }
      },
      "required": ["trace_id"]
    }
  ]
}
