{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.landfall.dev/events/v1/1.0/common/values.schema.json",
  "title": "Landfall bounded protocol values",
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$",
      "maxLength": 19
    },
    "rfc3339_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "maxLength": 30
    },
    "unsigned_decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,39})$",
      "maxLength": 40
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "bounded_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "solana_signature": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{87,88}$"
    },
    "solana_blockhash": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "json_pointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
      "maxLength": 256
    }
  }
}
