{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.landfall.dev/events/v1/1.0/common/fingerprint.schema.json",
  "title": "Landfall signed-transaction fingerprint",
  "type": "object",
  "properties": {
    "algorithm": { "const": "lf-hmac-sha256-v1" },
    "key_id": {
      "$ref": "identifiers.schema.json#/$defs/uuid_v7"
    },
    "value_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": ["algorithm", "key_id", "value_hex"],
  "additionalProperties": false
}
