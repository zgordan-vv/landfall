# Copy this file outside the repository, set its mode to 0600, and replace all
# values. It is used only with docker-compose.production.yml.
LANDFALL_POSTGRES_DB=landfall
LANDFALL_POSTGRES_USER=landfall_runtime
LANDFALL_POSTGRES_PASSWORD=replace-with-a-long-random-password
LANDFALL_OBSERVER_CONCURRENCY=4
LANDFALL_OBSERVER_POLL_INTERVAL_MS=500
LANDFALL_OBSERVER_RETRY_DELAY_SECONDS=5
LANDFALL_OBSERVER_LEASE_SECONDS=60
LANDFALL_OBSERVER_RECOVERY_INTERVAL_SECONDS=30
