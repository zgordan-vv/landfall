# Copy outside the repository as /srv/landfall/production.env on the Droplet.
# Do not commit the real file. The database URL itself belongs in
# /srv/landfall/secrets/database-url and must be the VPC-only TLS URI from
# DigitalOcean Managed PostgreSQL.
LANDFALL_SERVER_IMAGE=ghcr.io/zgordan-vv/landfall@sha256:replace_with_64_hex_digest
LANDFALL_DEPLOY_TARGET=managed-postgres
