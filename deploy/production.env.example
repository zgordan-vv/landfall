# Copy outside the repository as deployments/production.env. Do not commit it.
# Use the digest emitted by the GitHub Release workflow, not a mutable tag.
LANDFALL_SERVER_IMAGE=ghcr.io/zgordan-vv/landfall@sha256:replace_with_64_hex_digest
LANDFALL_POSTGRES_DB=landfall
LANDFALL_POSTGRES_USER=landfall
# This value is only used to initialize the production PostgreSQL volume.
# Place the real value in a protected deployment environment file.
LANDFALL_POSTGRES_PASSWORD=replace_with_a_unique_postgres_password
