# Public development defaults. These values are not production secrets because
# this file is committed. Copy it to .env and replace the password when local
# isolation from other host users matters.
LANDFALL_POSTGRES_DB=landfall
LANDFALL_POSTGRES_USER=landfall
LANDFALL_POSTGRES_PASSWORD=landfall-local-development-only
# Generate a unique 64-character hexadecimal value for every deployed environment.
# It encrypts private RPC URLs before they enter PostgreSQL. Never commit a real key.
LANDFALL_ROUTE_SECRETS_KEY=
# The observer worker claims at most this many jobs concurrently. Increase only
# after confirming that the configured Solana RPC endpoint permits the load.
LANDFALL_OBSERVER_CONCURRENCY=4
