{
  "name": "landfall-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.11.0 <25.0.0",
    "pnpm": "11.25.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm --recursive build",
    "check:protocol-generated": "node scripts/generate-protocol-ts.mjs --check",
    "check:solana-kit-lane": "node scripts/check-solana-kit-lane.mjs",
    "check:solana-lifecycle-fixtures": "node scripts/check-solana-lifecycle-fixtures.mjs",
    "check:web3js-v3-spike": "node scripts/check-web3js-v3-spike.mjs",
    "coverage": "pnpm run coverage:typescript && pnpm run coverage:rust",
    "coverage:rust": "bash scripts/coverage-rust.sh",
    "coverage:typescript": "c8 --all --extension .js --include 'packages/sdk-ts/dist/**' --exclude '**/tests/**' --reporter=text --reporter=lcov --reports-dir coverage/typescript node --test packages/sdk-ts/tests/*.test.mjs",
    "dev:dashboard": "pnpm --filter @landfall/dashboard dev",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "node scripts/check-typescript-dependency-direction.mjs && tsc -b --pretty false",
    "generate:protocol": "node scripts/generate-protocol-ts.mjs",
    "test": "pnpm --recursive --if-present test",
    "test:integration": "pnpm --recursive --if-present test:integration",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "c8": "10.1.3",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
